{
  "name": "@skypilot/parsifal",
  "version": "0.2.0",
  "private": false,
  "engines": {
    "node": ">=10"
  },
  "description": "Intelligent and flexible parser for command-line arguments",
  "keywords": [
    "cli",
    "command",
    "line",
    "argument",
    "options",
    "parser"
  ],
  "homepage": "https://github.com/skypilot-dev/parsifal#readme",
  "bugs": {
    "url": "https://github.com/skypilot-dev/parsifal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skypilot-dev/parsifal.git"
  },
  "license": "ISC",
  "author": {
    "name": "William Thorsen",
    "email": "william@thorsen.dev"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "all-cq-checks": "pnpm run typecheck && pnpm run lint --quiet && pnpm run test",
    "build": "pnpm run clean && pnpm run compile && pnpm run generate-typings",
    "check": "pnpm run typecheck && pnpm run fmt:check && pnpm run test",
    "ci": "pnpm run check && pnpm run build",
    "clean": "rimraf dist/*",
    "compile": "tsx config/build.ts",
    "fmt": "prettier --list-different --write .",
    "fmt:check": "prettier --check .",
    "generate-typings": "tsc --project tsconfig.generate-typings.json",
    "lint": "eslint --cache '**/*.{js,ts}'",
    "parse-args": "tsx src/scripts/parse-args.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint --quiet && pnpm test && pnpm run build",
    "publish:default": "pnpm publish --non-interactive",
    "tc": "pnpm run typecheck",
    "test": "vitest --config vitest.standalone.config.ts",
    "test:all": "vitest",
    "test:int": "vitest --config vitest.integration.config.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@skypilot/common-types": "2.3.0",
    "@types/node": "22.15.15",
    "@vitest/coverage-v8": "3.1.3",
    "esbuild": "0.25.4",
    "glob": "11.0.2",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.3"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
