{
  "name": "@skypilot/parsifal",
  "version": "0.2.0",
  "private": false,
  "engines": {
    "node": ">=10"
  },
  "description": "Intelligent and flexible parser for command-line arguments",
  "keywords": [
    "cli",
    "command",
    "line",
    "argument",
    "options",
    "parser"
  ],
  "homepage": "https://github.com/skypilot-dev/parsifal#readme",
  "bugs": {
    "url": "https://github.com/skypilot-dev/parsifal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skypilot-dev/parsifal.git"
  },
  "license": "ISC",
  "author": {
    "name": "William Thorsen",
    "email": "wthorsen@skypilot.dev"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "/lib"
  ],
  "scripts": {
    "all-ci-checks": "pnpm run all-cq-checks && pnpm run build",
    "all-cq-checks": "pnpm run typecheck && pnpm run lint --quiet && pnpm run test",
    "build": "rm -rf lib && pnpm run compile-ts",
    "ci": "pnpm run all-ci-checks",
    "compile-ts": "babel ./src --out-dir ./lib --extensions .ts --ignore '**/__tests__/*' --ignore '**/*.d.ts' && pnpm run generate-typings",
    "cq": "pnpm run all-cq-checks",
    "generate-typings": "tsc --project tsconfig.generate-typings.json",
    "lint": "eslint --cache '**/*.{js,ts}'",
    "parse-args": "babel-node --extensions .ts src/scripts/parse-args.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint --quiet && pnpm test && pnpm run build",
    "publish:default": "pnpm publish --non-interactive",
    "tc": "pnpm run typecheck",
    "test": "vitest --config vitest.standalone.config.ts",
    "test:all": "vitest",
    "test:int": "vitest --config vitest.integration.config.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@skypilot/common-types": "2.3.0",
    "@types/node": "22.15.15",
    "@vitest/coverage-v8": "3.1.3",
    "esbuild": "0.25.4",
    "glob": "11.0.2",
    "rimraf": "6.0.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.3"
  },
  "packageManager": "pnpm@10.10.0",
  "publishConfig": {
    "access": "restricted"
  }
}
